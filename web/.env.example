# Config frontend Vite (PRD Bab 14.3)
# Salin jadi web/.env lalu isi sesuai kebutuhan.
# File web/.env ASLI tidak boleh dicommit (sudah masuk .gitignore).

# Base API — SEBAGIAN BESAR KOSONGKAN (otomatis ikut base Vite):
# - DEV (proxy Vite /api -> http://localhost:5011, PRD Bab 14.4): kosongkan
# - LIVE sub-path (indeepcleaningid.site/app-booking): kosongkan juga ->
#   otomatis jadi /app-booking/api (ikut VITE_BASE_PATH build produksi)
# - Isi hanya bila fetch butuh host/port lain, contoh: http://localhost:5011
VITE_API_URL=

# Nomor WhatsApp admin (MinDi) buat tombol "Hubungi Admin" customer.
# Format internasional TANPA "+", contoh: 6281234567890
# Kalau kosong, tombol Hubungi Admin disembunyikan otomatis.
# LIVE (indeepcleaningid.site/app-booking): isi nomor asli saat build produksi.
VITE_WA_ADMIN=

# Basename router React buat deploy di sub-path (produksi).
# LIVE: VITE_BASENAME=/app-booking
# DEV: kosongkan (default '/')
VITE_BASENAME=
